# Copy this file to .env and supply only the values you use.
GEMINI_API_KEY=your_gemini_api_key_here
# Local default (no credentials): sqlite:///./recon_audit.db
# Managed Postgres: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite:///./recon_audit.db
RECON_DATA_DIR=
AGENT_STEP_BUDGET=4
# Parallel native tool-calling investigations after bulk triage.
AGENT_MAX_CONCURRENCY=4
AWS_REGION=ap-south-1
AWS_PROFILE=default
